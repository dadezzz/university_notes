{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": ["config:best-practices", "customManagers:biomeVersions", ":semanticCommits"],
  "packageRules": [
    {
      "automerge": true,
      "matchFileNames": [".devcontainer/**", ".forgejo/**", "ci.Dockerfile"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "ci"
    },
    {
      "automerge": true,
      "matchFileNames": ["Dockerfile"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "fix"
    },
    {
      "matchFileNames": ["Dockerfile"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    },
    {
      "automerge": true,
      "matchPackageNames": ["@astro/check", "@biomejs/biome", "prettier*", "pnpm", "typescript"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "chore"
    },
    {
      "automerge": true,
      "matchPackageNames": ["git.zarantonello.dev/university/notes"],
      "matchCurrentVersion": "ci",
      "semanticCommitType": "chore"
    },
    {
      "automerge": true,
      "matchPackageNames": ["git.zarantonello.dev/university/notes"]
    }
  ],
  "prHourlyLimit": 4
}
