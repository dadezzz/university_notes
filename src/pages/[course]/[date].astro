---
// This page renders the lesson like Starlight would, but it sets the correct
// lang for each one on the wrapper element, as specified in the frontmatter.

import { getImage } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import { rehypeHeadingIds, rehypeShiki } from "@astrojs/markdown-remark";
import { Aside } from "@astrojs/starlight/components";
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import type { GetStaticPaths, MarkdownHeading } from "astro";
import { experimental_AstroContainer } from "astro/container";
import type { Element, Root } from "hast";
import { fromHtml } from "hast-util-from-html";
import { toHtml } from "hast-util-to-html";
import { unified } from "unified";
import { visit } from "unist-util-visit";

export const getStaticPaths: GetStaticPaths = async () => {
  const lessons = await getCollection("docs");
  return lessons.flatMap((l) => {
    // Lessons live at `[course]/[date]`. Ignore anything with a different shape
    // so a stray nested file cannot generate a malformed route.
    const parts = l.id.split("/");
    const [course, date] = parts;
    if (parts.length !== 2 || !course || !date) {
      return [];
    }
    return [{ params: { course, date } }];
  });
};

const { course, date } = Astro.params;
const id = `${course}/${date}`;
const lesson = await getEntry("docs", id);
if (!lesson) {
  throw new Error(`lesson '${id}' not found`);
}

// Adds the not-content class inside math blocks to disable starlight's spacing
// overrides.
function addMathNotContent() {
  return (tree: Root) => {
    visit(tree, "element", (node) => {
      if (node.tagName === "math") {
        node.properties.className ??= [];
        node.properties.className.push("not-content");
      }
    });
  };
}

// Transforms typst's data-lang attribute in the language class needed by shiki.
function normalizeCodeLang() {
  return (tree: Root) => {
    visit(tree, "element", (node) => {
      if (node.tagName === "code" && node.properties?.dataLang) {
        const lang = node.properties.dataLang as string;
        node.properties.className ??= [];
        node.properties.className.push(`language-${lang}`);
      }
    });
  };
}

const container = await experimental_AstroContainer.create();

// Register headings to be rendered in the table of contents.
const headings: MarkdownHeading[] = [];

function renderStarlightHeadings() {
  return async (tree: Root) => {
    const matches: { node: Element; index?: number; parent?: Element | Root }[] = [];

    visit(tree, "element", (node, index, parent) => {
      if (node.tagName.length === 2 && node.tagName[0] === "h" && node.tagName[1] >= "1" && node.tagName[1] <= "6") {
        matches.push({ node, index, parent });
      }
    });

    await Promise.all(
      matches.map(async ({ node, index, parent }) => {
        const level = Number(node.tagName[1]);
        const childrenHtml = toHtml(node.children);

        const headingHtml = await container.renderToString(AnchorHeading, {
          locals: Astro.locals,
          props: { id: node.properties.id, level },
          slots: { default: childrenHtml },
        });

        headings.push({ depth: level, slug: node.properties.id ?? "", text: childrenHtml });

        const parsedRoot = fromHtml(headingHtml, { fragment: true });

        // Find the top-level HTML element inside the parsed fragment
        const newElement = parsedRoot.children.find((child): child is Element => child.type === "element");

        if (newElement && parent && typeof index === "number") {
          parent.children[index] = newElement;
        }
      }),
    );
  };
}

function renderStarlightAsides() {
  return async (tree: Root) => {
    const matches: { node: Element; index?: number; parent?: Element | Root }[] = [];

    visit(tree, "element", (node, index, parent) => {
      if (node.properties.dataStarlightAside) {
        matches.push({ node, index, parent });
      }
    });

    await Promise.all(
      matches.map(async ({ node, index, parent }) => {
        const asideHtml = await container.renderToString(Aside, {
          locals: Astro.locals,
          props: {
            type: node.properties.dataStarlightAside,
            title: node.properties.dataStarlightAsideTitle,
          },
          slots: { default: toHtml(node.children) },
        });

        const parsedRoot = fromHtml(asideHtml, { fragment: true });

        // Find the top-level HTML element inside the parsed fragment
        const newElement = parsedRoot.children.find((child): child is Element => child.type === "element");

        if (newElement && parent && typeof index === "number") {
          parent.children[index] = newElement;
        }
      }),
    );
  };
}

const images = import.meta.glob<{ default: ImageMetadata }>("./*/images/*.{svg,png,jpg,jpeg,gif,webp}", {
  base: "/src/content/docs",
  eager: false,
});

function renderStarlightImages() {
  return async (tree: Root) => {
    const matches: { node: Element; index?: number; parent?: Element | Root }[] = [];

    visit(tree, "element", (node, index, parent) => {
      if (node.properties.dataStarlightImgSrc) {
        matches.push({ node, index, parent });
      }
    });

    await Promise.all(
      matches.map(async ({ node, index, parent }) => {
        const imagePath = `./${course}/${node.properties.dataStarlightImgSrc}`;
        const imageMetadata = (await images[imagePath]()).default;
        const imageFormats = imagePath.endsWith(".svg") ? ["svg"] : ["avif", "webp", "png"];

        const imageResults = await Promise.all(imageFormats.map((f) => getImage({ src: imageMetadata, format: f })));

        let pictureElement: Element = {
          type: "element",
          tagName: "picture",
          children: imageResults.flatMap((result) => {
            if (result.options.format === "svg" || !result.srcSet.attribute) {
              return [];
            }

            const sourceElement: Element = {
              type: "element",
              tagName: "source",
              children: [],
              properties: { srcset: result.srcSet.attribute, type: `image/${result.options.format}` },
            };
            return [sourceElement];
          }),
          properties: {},
        };

        const fallbackResult = imageResults[imageResults.length - 1];
        pictureElement.children.push({
          type: "element",
          tagName: "img",
          children: [],
          properties: {
            ...fallbackResult.attributes,
            src: fallbackResult.src,
            alt: (node.properties.dataStarlightImgAlt ?? "").toString(),
          },
        });

        if (parent && typeof index === "number") {
          parent.children[index] = pictureElement;
        }
      }),
    );
  };
}

const processor = unified()
  .use(addMathNotContent)
  .use(normalizeCodeLang)
  .use(rehypeShiki, { theme: "one-dark-pro" })
  .use(rehypeHeadingIds)
  .use(renderStarlightHeadings)
  .use(renderStarlightAsides)
  .use(renderStarlightImages);

// `fragment: true` is required because the loader stores only the inner
// content of the compiled `<body>`; without it the parser would wrap everything
// in an extra `<html><head><body>` document.
const typstTree = fromHtml(lesson.rendered?.html ?? "", { fragment: true });
const processedTree = await processor.run(typstTree);
const frontmatter = lesson.data as StarlightPageProps["frontmatter"];

// Restore the editUrl since the one in starlight config doesn't work.
frontmatter.editUrl = `https://git.zarantonello.dev/university/notes/_edit/main/${lesson.filePath}`;
---

<StarlightPage {frontmatter} {headings} lang={frontmatter.lang} set:html={toHtml(processedTree)} />
