---
// Home page of the website.

import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CoursePageLink from "../components/CoursePageLink.astro";

// The content collection order is not guaranteed to be stable, so sort by
// course name to keep the listing deterministic.
const courses = (await getCollection("courses")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<StarlightPage
  frontmatter={{
    next: false,
    pagefind: false,
    prev: false,
    tableOfContents: false,
    title: "Home",
    lang: "en"
  }}
>
  <p>Welcome to my collection of course notes!</p>

  <p>
    These are my notes from the Information, Communications and Electronics (ICE) engineering program at the University
    of Trento. I am currently in my second year.
  </p>

  <p>
    Most of the initial courses are in Italian, but later on I will attend English lessons. I will keep the notes in
    their original language to avoid introducing errors from translation.
  </p>

  <h2>Contributing</h2>

  <p>
    If you find any errors or have suggestions for improvements, please contribute! Submit corrections via
    <a style="margin-left: 0.25rem;" href="https://git.zarantonello.dev/university/notes">Git</a>
    . To get access, send me an email to request an account.
  </p>

  <h2>Courses</h2>

  <nav>
    <ul>
      {courses.map((c) => (
        <li>
          <CoursePageLink course={c} />
        </li>
      ))}
    </ul>
  </nav>
</StarlightPage>
