#import "../../_templates/frames.typ" as f
#import "../../_templates/starlight.typ" as starlight
#import "@preview/cetz:0.5.2"

#let draw() = {
  import cetz.draw: *

  let c-axis = color.hsl(0deg, 0%, 50%)
  let c-b1 = color.hsl(210deg, 50%, 50%)
  let c-b2 = color.hsl(150deg, 50%, 50%)
  let c-b3 = color.hsl(330deg, 50%, 50%)
  let c-edge = color.hsl(0deg, 0%, 50%)

  f.axes3d(5.5, 5.0, 4.0, stroke: (paint: c-axis, thickness: 0.2pt))

  let O = (0, 0, 0)
  let b1 = (2.6, 0.4, 0.6)
  let b2 = (0.7, 5, 0.4)
  let b3 = (0.5, 0.6, 2.2)
  let b12 = f.vadd(b1, b2)
  let b13 = f.vadd(b1, b3)
  let b23 = f.vadd(b2, b3)
  let b123 = f.vadd(b12, b3)

  // Parallelepiped generated by the three basis vectors.
  line(
    O,
    b1,
    b12,
    b2,
    close: true,
    stroke: (paint: c-edge, thickness: 0.3pt, dash: "dashed"),
  )
  line(
    b3,
    b13,
    b123,
    b23,
    close: true,
    stroke: (paint: c-edge, thickness: 0.3pt, dash: "dashed"),
  )
  line(O, b3, stroke: (paint: c-edge, thickness: 0.5pt, dash: "dashed"))
  line(b1, b13, stroke: (paint: c-edge, thickness: 0.5pt, dash: "dashed"))
  line(b2, b23, stroke: (paint: c-edge, thickness: 0.5pt, dash: "dashed"))
  line(b12, b123, stroke: (paint: c-edge, thickness: 0.5pt, dash: "dashed"))

  f.arrow(O, b1, stroke: (paint: c-b1, thickness: 1pt))
  f.arrow(O, b2, stroke: (paint: c-b2, thickness: 1pt))
  f.arrow(O, b3, stroke: (paint: c-b3, thickness: 1pt))

  f.label-at(b1, $bold(b)_1$, color: c-b1, anchor: "south-east", padding: 0.1)
  f.label-at(b2, $bold(b)_2$, color: c-b2, anchor: "north-west", padding: 0.1)
  f.label-at(b3, $bold(b)_3$, color: c-b3, anchor: "west", padding: 0.1)
  f.label-at(
    (3.0, 3.0, 3.6),
    $cal(B)$,
    color: c-axis,
    anchor: "west",
    padding: 0.1,
  )
}

#starlight.frame(
  cetz.canvas(
    cetz.draw.perspective(
      y: 150deg,
      z: 180deg,
      x: -15deg,
      cetz.draw.on-xz(draw()),
    ),
  ),
)
