{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "kubernetes": {
    "managerFilePatterns": ["/kubernetes/.+\\.yaml$/"]
  },
  "packageRules": [
    // Rebuild the container if something is updated in the Dockerfile.
    {
      "matchFileNames": ["Dockerfile"],
      "semanticCommitType": "fix"
    },
    {
      "automerge": true,
      "matchFileNames": ["Dockerfile"],
      "matchUpdateTypes": ["!major"]
    },
    // Automerge and group devcontainer, actions and ci deps.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".devcontainer/**", ".forgejo/**", "ci.Dockerfile"]
    },
    // Formatters and linters get automerged.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchPackageNames": [
        // Automerge the ci image and don't trigger a release even in Dockerfile.
        "git.zarantonello.dev/university/notes-ci",
        // Also group the pnpm in the packageManager in package.json.
        "pnpm",
        "@biomejs/biome",
        "@types/*",
        "svelte-check",
        "turbo",
        "vitest"
      ],
      // Override the 'fix' commit type set by the Dockerfile rule.
      "semanticCommitType": "chore"
    },
    // Automerge the container image in the kubernetes deployment.
    {
      "automerge": true,
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["!major"]
    }
  ]
}
