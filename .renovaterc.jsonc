{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:biomeVersions",
    ":semanticCommits"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/kubernetes/.+\\.yaml$/"]
  },
  "packageRules": [
    // Rebuild the container if something like caddy is updated in the Dockerfile.
    {
      "matchFileNames": ["Dockerfile"],
      "semanticCommitType": "fix"
    },
    {
      "automerge": true,
      "matchFileNames": ["Dockerfile"],
      "matchUpdateTypes": ["!major"]
    },
    // Automerge and group devcontainer, actions and ci deps.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".devcontainer/**", ".forgejo/**", "ci.Dockerfile"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "ci"
    },
    // Automerge the ci image and don't trigger a release even in Dockerfile.
    // Automerge linters and formatters.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchPackageNames": [
        "git.zarantonello.dev/infra/ci-pnpm",
        "@astro/check",
        "@biomejs/biome",
        "pnpm",
        "typescript",
        "@types/*"
      ],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "chore"
    },
    // Automerge the container image in the kubernetes deployment.
    {
      "automerge": true,
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["!major"]
    }
  ],
  "prHourlyLimit": 6
}
